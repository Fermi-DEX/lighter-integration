pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {BigMulMod} from "../src/BigMulMod.sol";

/// Known-answer and property tests for BigMulMod.mulmod2048.
/// Every expected value was computed independently with Python big
/// integers (== num-bigint); see vectors/gen_segment_vector.py note in
/// README.md for reproduction. N is the RSA-2048 modulus from
/// crates/vdf/src/backend.rs (Group::default_rsa2048()).
contract BigMulModTest is Test {
    BigMulMod internal big;

    function setUp() public {
        big = new BigMulMod();
    }

    /// Assert mulmod2048(a,b,n) == expected (compare length + keccak).
    function _check(
        bytes memory a,
        bytes memory b,
        bytes memory n,
        bytes memory expected
    ) internal view {
        bytes memory got = big.mulmod2048(a, b, n);
        assertEq(got.length, 256, "output length");
        assertEq(keccak256(got), keccak256(expected), "product mismatch");
    }

    function test_katSmall() public view {
        (bytes memory a, bytes memory b, bytes memory n, bytes memory e) = _caseSmall();
        _check(a, b, n, e);
    }

    function _caseSmall()
        internal
        pure
        returns (bytes memory a, bytes memory b, bytes memory n, bytes memory expected)
    {
        a = hex"";
        b = hex"";
        n = hex"";
        expected = hex"";
    }

    function test_katZero() public view {
        (bytes memory a, bytes memory b, bytes memory n, bytes memory e) = _caseZero();
        _check(a, b, n, e);
    }

    function _caseZero()
        internal
        pure
        returns (bytes memory a, bytes memory b, bytes memory n, bytes memory expected)
    {
        a = hex"";
        b = hex"";
        n = hex"";
        expected = hex"";
    }

    function test_katOne() public view {
        (bytes memory a, bytes memory b, bytes memory n, bytes memory e) = _caseOne();
        _check(a, b, n, e);
    }

    function _caseOne()
        internal
        pure
        returns (bytes memory a, bytes memory b, bytes memory n, bytes memory expected)
    {
        a = hex"";
        b = hex"";
        n = hex"";
        expected = hex"";
    }

    function test_katNminus1() public view {
        (bytes memory a, bytes memory b, bytes memory n, bytes memory e) = _caseNminus1();
        _check(a, b, n, e);
    }

    function _caseNminus1()
        internal
        pure
        returns (bytes memory a, bytes memory b, bytes memory n, bytes memory expected)
    {
        a = hex"";
        b = hex"";
        n = hex"";
        expected = hex"";
    }

    function test_katFullA() public view {
        (bytes memory a, bytes memory b, bytes memory n, bytes memory e) = _caseFullA();
        _check(a, b, n, e);
    }

    function _caseFullA()
        internal
        pure
        returns (bytes memory a, bytes memory b, bytes memory n, bytes memory expected)
    {
        a = hex"";
        b = hex"";
        n = hex"";
        expected = hex"";
    }

    function test_katFullB() public view {
        (bytes memory a, bytes memory b, bytes memory n, bytes memory e) = _caseFullB();
        _check(a, b, n, e);
    }

    function _caseFullB()
        internal
        pure
        returns (bytes memory a, bytes memory b, bytes memory n, bytes memory expected)
    {
        a = hex"";
        b = hex"";
        n = hex"";
        expected = hex"";
    }

    function test_katNarrowMod() public view {
        (bytes memory a, bytes memory b, bytes memory n, bytes memory e) = _caseNarrowMod();
        _check(a, b, n, e);
    }

    function _caseNarrowMod()
        internal
        pure
        returns (bytes memory a, bytes memory b, bytes memory n, bytes memory expected)
    {
        a = hex"";
        b = hex"";
        n = hex"";
        expected = hex"";
    }

    /// Multiplication is commutative: mulmod(a,b,n) == mulmod(b,a,n).
    function test_commutative() public view {
        (bytes memory a, bytes memory b, bytes memory n,) = _caseFullA();
        assertEq(
            keccak256(big.mulmod2048(a, b, n)),
            keccak256(big.mulmod2048(b, a, n)),
            "not commutative"
        );
    }

    function test_revertOnShortA() public {
        bytes memory short = new bytes(255);
        bytes memory ok = new bytes(256);
        ok[255] = 0x01;
        vm.expectRevert(bytes("operand length"));
        big.mulmod2048(short, ok, ok);
    }

    function test_revertOnLongModulus() public {
        bytes memory ok = new bytes(256);
        ok[255] = 0x01;
        bytes memory long = new bytes(257);
        vm.expectRevert(bytes("operand length"));
        big.mulmod2048(ok, ok, long);
    }
}
